{
    admin off
    auto_https off
}

:80 {
    # 1. API & Auth (Django -> Service Name: api)
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /auth/* {
        reverse_proxy api:8000
    }

    # 2. Live Service (Node -> Service Name: live)
    handle /live/* {
        reverse_proxy plane-live:3000
    }

    # 3. Spaces (Nginx -> Service Name: space)
    handle_path /spaces/* {
        reverse_proxy space:80
    }

    # 4. Admin (Nginx -> Service Name: admin)
    handle_path /god-mode/* {
        reverse_proxy admin:80
    }

    # 5. Main Web App (Nginx -> Service Name: web)
    handle /* {
        reverse_proxy web:80
    }

    log {
        output stdout
    }
}
